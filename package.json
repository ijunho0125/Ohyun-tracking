{
  "name": "motion-arcade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite --host 127.0.0.1",
    "build": "tsc -b && node scripts/prepare-assets.mjs && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/server.mjs",
    "start": "node dist-server/server.mjs",
    "dev:lan": "node scripts/prepare-assets.mjs && vite --host 0.0.0.0",
    "preview": "vite preview --host 127.0.0.1",
    "setup:models": "node scripts/download-models.mjs",
    "test": "vitest run",
    "test:browser": "node tests/browser-check.mjs",
    "test:character-sync": "node tests/character-sync-browser-check.mjs",
    "test:motion": "node tests/motion-browser-check.mjs",
    "test:dino-motion": "node tests/dino-motion-browser-check.mjs",
    "test:restart": "node tests/restart-browser-check.mjs",
    "test:tracking-speed": "node tests/tracking-speed-browser-check.mjs",
    "test:vision": "node tests/vision-browser-check.mjs",
    "test:right-hand": "node tests/right-hand-browser-check.mjs",
    "test:festival": "node tests/festival-browser-check.mjs",
    "typecheck": "tsc --noEmit",
    "test:loading": "node tests/loading-browser-check.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "esbuild": "0.25.12",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
